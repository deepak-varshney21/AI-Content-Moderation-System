# Server Settings
PROJECT_NAME="AI-Powered Severity-Aware Multi-Label Content Moderation System"
VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]

# Hugging Face Model Configuration
MODEL_NAME="oleksiizirka/xlm-roberta-toxicity-classifier"
FALLBACK_MODEL_NAME="unitary/toxic-bert"
USE_GPU_IF_AVAILABLE=true
MAX_SEQUENCE_LENGTH=512
MAX_COMMENT_LENGTH=2500

# Moderation Thresholds
DEFAULT_THRESHOLD=0.50

# Database
DATABASE_URL="sqlite:///./moderation.db"
